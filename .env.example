# ==========================================
# SpeakPro AI - Environment Configuration Template (.env.example)
# ==========================================
# Copy this file to .env and fill in your API keys and configuration.

# --- 1. GOOGLE GEMINI AI API KEY ---
# Get your Google Gemini API Key at: https://aistudio.google.com/
# Leave empty to use the intelligent offline NLP fallback evaluation engine automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# --- 2. SUPABASE POSTGRESQL DATABASE CONFIGURATION ---
# Optional: To store login IDs, user accounts, and speech reports in Supabase PostgreSQL:
# Paste your Supabase Database URI (e.g. postgres://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres)
# Leave commented or empty to default to local D:\AI_Public_Speaking_Coach\database\db.sqlite3
# SUPABASE_DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- 3. DJANGO SECURITY & SERVER MODE ---
DJANGO_SECRET_KEY=django-insecure-speakpro-ai-public-speaking-coach-2026-secret-key-!@#
DEBUG=True
