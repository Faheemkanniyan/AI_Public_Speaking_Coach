# ==========================================
# SpeakPro AI - Environment Configuration Template (.env.example)
# ==========================================
# Copy this file to .env and fill in your API keys and configuration.

# --- 1. GOOGLE GEMINI AI API KEY ---
# Get your Google Gemini API Key at: https://aistudio.google.com/
# Leave empty to use the intelligent offline NLP fallback evaluation engine automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# --- 2. ASSEMBLYAI API KEY (OPTIONAL) ---
# For high-accuracy speech-to-text & filler word detection.
# Get your key at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# --- 3. OPENAI API KEY (OPTIONAL) ---
# For Text-to-Speech (TTS) audio feedback generation.
OPENAI_API_KEY=your_openai_api_key_here

# --- 4. DJANGO SECURITY & SERVER MODE ---
DJANGO_SECRET_KEY=your_django_secret_key_placeholder
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- 4. POSTGRESQL DATABASE CONFIGURATION ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ai_speaking_coach
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# --- 5. CELERY & REDIS MESSAGE BROKER ---
# Redis message broker URL for background speech evaluation tasks
CELERY_BROKER_URL=redis://localhost:6379/0
# Celery backend for storing task results
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set to True to run tasks synchronously without Redis
CELERY_TASK_ALWAYS_EAGER=False

# --- 6. GEMINI MODEL CONFIGURATION ---
GEMINI_MODEL=gemini-2.5-flash

# --- 7. EMAIL CONFIGURATION (SMTP in production) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=SpeakPro AI <noreply@example.com>

